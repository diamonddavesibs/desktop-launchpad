<Window x:Class="DesktopLaunchpad.ThemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#1B2128"
        Foreground="White"
        FontSize="14">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#B0BAC5" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,0,20,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,8,24,20">
        <TextBlock Style="{StaticResource Label}" Text="Look" />
        <WrapPanel x:Name="PresetPanel" />

        <TextBlock Style="{StaticResource Label}" Text="Highlight color (edit mode, hover and buttons)" />
        <WrapPanel x:Name="AccentPanel" />

        <TextBlock Style="{StaticResource Label}" Text="Background picture" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ImageText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="Choose…" Margin="8,0,0,0" MinWidth="0" Click="ChooseImage_Click" />
            <Button x:Name="RemoveImageButton" Grid.Column="2" Content="Remove" Margin="6,0,0,0" MinWidth="0" Click="RemoveImage_Click" />
        </Grid>

        <TextBlock Style="{StaticResource Label}" Text="Backdrop strength" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="StrengthSlider" Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" ValueChanged="StrengthSlider_ValueChanged" />
            <TextBlock x:Name="StrengthText" Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <TextBlock FontSize="12" Foreground="#80909C" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="Lower lets more of your desktop, or your picture, show through." />

        <TextBlock Style="{StaticResource Label}" Text="Card shape" />
        <StackPanel x:Name="ShapePanel" Orientation="Horizontal" />

        <TextBlock FontSize="12" Foreground="#80909C" Margin="0,18,0,0" TextWrapping="Wrap"
                   Text="Changes show on the launchpad behind this window as you pick them. Cards you gave their own color keep it." />

        <Grid Margin="0,20,0,0">
            <Button Content="Reset to default" HorizontalAlignment="Left" Click="Reset_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" IsDefault="True" Click="Save_Click" />
                <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
