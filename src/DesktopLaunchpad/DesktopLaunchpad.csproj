<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms is used only for the system tray icon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DesktopLaunchpad</RootNamespace>
    <AssemblyName>DesktopLaunchpad</AssemblyName>
    <!-- Lets the project compile on non-Windows build machines (CI). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The release workflow overrides this with the number typed when publishing a release. -->
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\launchpad.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms and WPF both define these names; prefer the WPF ones. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\launchpad.ico" />
  </ItemGroup>

</Project>
