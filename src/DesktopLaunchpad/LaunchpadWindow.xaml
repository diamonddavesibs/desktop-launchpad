<Window x:Class="DesktopLaunchpad.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Launchpad"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0">

    <!-- Dimmed backdrop over the whole screen. Clicking empty space closes the launchpad. -->
    <Grid x:Name="Backdrop" Background="#CC101418" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="48,40,48,0">
            <TextBlock Text="Launchpad" FontSize="36" FontWeight="SemiBold" Foreground="White" />
            <TextBlock x:Name="ClockText" FontSize="16" Foreground="#B0BAC5" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Cards are added from cards.json each time the launchpad opens. -->
        <ScrollViewer x:Name="CardScroller" Grid.Row="1" Margin="40,16,40,16"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="CardPanel" Background="Transparent" />
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="48,0,48,24" Foreground="#80909C" FontSize="13"
                   Text="Click a card to open it  ·  Esc or click empty space to close  ·  Edit cards from the tray icon menu" />
    </Grid>
</Window>
