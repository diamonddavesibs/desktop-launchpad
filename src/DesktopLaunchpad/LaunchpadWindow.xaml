<Window x:Class="DesktopLaunchpad.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Launchpad"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0">

    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Dimmed backdrop over the whole screen. Clicking empty space closes the launchpad. -->
    <!-- The Backdrop's own background is the optional picture; the BackdropTint layer
         on top of it is the theme color. Both are set from the current theme in code. -->
    <Grid x:Name="Backdrop" Background="Transparent" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="BackdropTint" Grid.RowSpan="3" Background="#CC101418" />

        <Grid Grid.Row="0" Margin="48,40,48,0">
            <StackPanel>
                <TextBlock Text="Launchpad" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
                <TextBlock x:Name="ClockText" FontSize="16" Foreground="{DynamicResource ThemeSubtleText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="AddButton" Style="{StaticResource HeaderButton}" Content="+  Add card"
                        Visibility="Collapsed" Click="AddButton_Click" />
                <Button x:Name="ThemeButton" Style="{StaticResource HeaderButton}" Content="Theme" Click="ThemeButton_Click" />
                <Button x:Name="EditButton" Style="{StaticResource HeaderButton}" Content="Edit" Click="EditButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Cards are placed on this canvas at their saved positions. -->
        <ScrollViewer x:Name="CardScroller" Grid.Row="1" Margin="48,24,48,16"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Canvas x:Name="CardCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>

        <TextBlock x:Name="FooterText" Grid.Row="2" Margin="48,0,48,24" Foreground="{DynamicResource ThemeFaintText}" FontSize="13" />
    </Grid>
</Window>
