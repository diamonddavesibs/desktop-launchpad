<Window x:Class="DesktopLaunchpad.CardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit card"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#1B2128"
        Foreground="White"
        FontSize="14">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#B0BAC5" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Background" Value="#0F1317" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3A444F" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,0,20,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,12,24,20">
        <TextBlock Style="{StaticResource Label}" Text="Name on the card" />
        <TextBox x:Name="TitleBox" />

        <TextBlock Style="{StaticResource Label}" Text="What it opens" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ProgramRadio" Content="A program, file or folder" GroupName="Type" Checked="Type_Changed" />
            <RadioButton x:Name="WebsiteRadio" Content="A website" GroupName="Type" Checked="Type_Changed" />
            <RadioButton x:Name="WorkspaceRadio" Content="Several at once" GroupName="Type" Checked="Type_Changed" />
        </StackPanel>

        <TextBlock x:Name="TargetLabel" Style="{StaticResource Label}" Text="Program" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TargetBox" Grid.Column="0" PreviewKeyDown="TargetBox_PreviewKeyDown" />
            <Button x:Name="BrowseFileButton" Grid.Column="1" Content="File…" Margin="8,0,0,0" MinWidth="0" Click="BrowseFile_Click" />
            <Button x:Name="BrowseFolderButton" Grid.Column="2" Content="Folder…" Margin="6,0,0,0" MinWidth="0" Click="BrowseFolder_Click" />
        </Grid>
        <TextBlock x:Name="TargetHint" FontSize="12" Foreground="#80909C" Margin="0,4,0,0" TextWrapping="Wrap" />

        <StackPanel x:Name="WorkspacePanel" Visibility="Collapsed">
            <Button Content="Add to workspace" HorizontalAlignment="Left" Margin="0,8,0,0" Click="AddItem_Click" />
            <TextBlock Style="{StaticResource Label}" Text="This workspace opens" />
            <ListBox x:Name="ItemsList" Height="150" Background="#0F1317" Foreground="White" BorderBrush="#3A444F" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Move up" MinWidth="0" Click="MoveUp_Click" />
                <Button Content="Move down" MinWidth="0" Margin="6,0,0,0" Click="MoveDown_Click" />
                <Button Content="Remove" MinWidth="0" Margin="6,0,0,0" Click="RemoveItem_Click" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="ArgumentsPanel">
            <TextBlock Style="{StaticResource Label}" Text="Arguments (optional)" />
            <TextBox x:Name="ArgumentsBox" />
        </StackPanel>

        <StackPanel x:Name="BrowserPanel">
            <TextBlock x:Name="BrowserLabel" Style="{StaticResource Label}" Text="Open in" />
            <ComboBox x:Name="BrowserCombo" SelectionChanged="BrowserCombo_SelectionChanged" />
        </StackPanel>

        <TextBlock Style="{StaticResource Label}" Text="Color" />
        <WrapPanel x:Name="SwatchPanel" />

        <TextBlock x:Name="ErrorText" Foreground="#F87171" Margin="0,14,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
